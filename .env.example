# MongoDB Connection URI (replace with your MongoDB Atlas or local connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogging_db?retryWrites=true&w=majority

# JWT Secret for cookie authentication (use a 32+ character random string in production)
JWT_SECRET=super_secret_blogging_ui_key_generate_your_own_secret_key_here_12345

# App environment
NODE_ENV=development
